# ==============================================================================
# CARY Flutter Web - Apache .htaccess Cache & Performance Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve pre-compressed Brotli files if available
  <IfModule mod_headers.c>
    RewriteCond %{HTTP:Accept-Encoding} br
    RewriteCond %{REQUEST_FILENAME}\.br -f
    RewriteRule ^(.*)$ $1\.br [L]
    RewriteRule \.wasm\.br$ - [T=application/wasm,E=no-gzip:1]
    RewriteRule \.js\.br$ - [T=text/javascript,E=no-gzip:1]
    RewriteRule \.css\.br$ - [T=text/css,E=no-gzip:1]
    RewriteRule \.html\.br$ - [T=text/html,E=no-gzip:1]
    RewriteRule \.json\.br$ - [T=application/json,E=no-gzip:1]
    <FilesMatch "\.br$">
      Header set Content-Encoding br
      Header append Vary Accept-Encoding
    </FilesMatch>
  </IfModule>

  # Flutter Single Page App URL Routing
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache-Control Lifetimes
<IfModule mod_expires.c>
  ExpiresActive On

  # Entry HTML & Service Worker: Instant revalidation (0 seconds)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"

  # Immutable Wasm & Fonts
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Modern Images
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Revalidation headers for HTML and bootstrap
  <FilesMatch "(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Immutable assets
  <FilesMatch "\.(wasm|woff2|ttf|webp|avif|part\.js|js\.map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
